# Configurações de Domínio
# Para desenvolvimento local, use https://localhost
APP_DOMAIN=https://localhost

# Senha do Banco de Dados Postgres (sacre.db)
POSTGRES_PASSWORD=postgres

# Chave secreta JWT para o Supabase (PostgREST, Auth e Studio)
JWT_SECRET=1aduOYIcIG2/UPJyaF/LdVYQQKoiX5SW+HBO7zHSk+k=

# Chaves de API do Supabase (devem ser geradas usando a assinatura da JWT_SECRET ou geradas pelo CLI do Supabase)
# Para fins de desenvolvimento local, coloque as chaves correspondentes aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Configurações de E-mail para Autenticação (Opcionais)
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_SMTP_HOST=smtp.example.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=smtp-user
GOTRUE_SMTP_PASS=smtp-password

# Configuração opcional de JWT para Auth no Supabase Studio
STUDIO_AUTH_JWT=

# Configurações do Administrador Inicial da Aplicação
INITIAL_ADMIN_EMAIL=admin@sacre.org
INITIAL_ADMIN_PASSWORD=Abc@123#
